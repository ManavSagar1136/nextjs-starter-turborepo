{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",

    "NEXT_PUBLIC_PUBLIC_APP_URL",
    "NEXT_PUBLIC_USER_APP_URL",
    "NEXT_PUBLIC_ADMIN_APP_URL",
    "NEXT_PUBLIC_DOCS_APP_URL",

    "API_SECRET",
    "NEXT_PUBLIC_API_SECRET",
    "APP_JWT_SECRET",

    "SAAS_CLIENT_SECRET",
    "NEXT_PUBLIC_SAAS_SERVER_URL",
    "NEXT_PUBLIC_SAAS_ORG_ID",
    "NEXT_PUBLIC_SAAS_CLIENT_ID"
  ],
  "globalDependencies": [],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "@buildbase/eslint-config#build": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
