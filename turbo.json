{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "DATABASE_URL",

    "NEXT_PUBLIC_PUBLIC_APP_URL",
    "NEXT_PUBLIC_USER_APP_URL",
    "NEXT_PUBLIC_ADMIN_APP_URL",
    "NEXT_PUBLIC_DOCS_APP_URL",

    "API_SECRET",
    "NEXT_PUBLIC_API_SECRET",
    "APP_JWT_SECRET",

    "SAAS_CLIENT_SECRET",
    "NEXT_PUBLIC_SAAS_SERVER_URL",
    "NEXT_PUBLIC_SAAS_ORG_ID",
    "NEXT_PUBLIC_SAAS_CLIENT_ID",

    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "ENABLE_CACHE_WARMING",
    "CACHE_WARMING_INTERVAL",

    "QSTASH_TOKEN",
    "QSTASH_URL",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",

    "CRON_SECRET",

    "NEW_RELIC_ENABLED",
    "NEW_RELIC_LICENSE_KEY",
    "NEW_RELIC_APP_NAME",
    "LOG_LEVEL"
  ],
  "globalDependencies": [],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"]
    },
    "@buildbase/eslint-config#build": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "vitest.config.*"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "vitest.config.*"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "vitest.config.*"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "inputs": ["e2e/**", "playwright.config.*"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "vitest.config.*"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
