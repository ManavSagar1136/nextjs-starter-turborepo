{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "DATABASE_URL",

    "NEXT_PUBLIC_PUBLIC_APP_URL",
    "NEXT_PUBLIC_USER_APP_URL",
    "NEXT_PUBLIC_ADMIN_APP_URL",
    "NEXT_PUBLIC_DOCS_APP_URL",

    "API_SECRET",
    "NEXT_PUBLIC_API_SECRET",
    "APP_JWT_SECRET",

    "SAAS_CLIENT_SECRET",
    "NEXT_PUBLIC_SAAS_SERVER_URL",
    "NEXT_PUBLIC_SAAS_ORG_ID",
    "NEXT_PUBLIC_SAAS_CLIENT_ID",

    "NEXT_PUBLIC_GOOGLE_ANALYTICS_ID",

    "NEXT_PUBLIC_AFFILIATE_PROGRAM_LINK",
    "NEXT_PUBLIC_AFFILIATE_STORE_NAME",
    "NEXT_PUBLIC_BOOK_MEETING_LINK",

    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "ENABLE_CACHE_WARMING",
    "CACHE_WARMING_INTERVAL",

    "QSTASH_TOKEN",
    "QSTASH_URL",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",

    "CRON_SECRET",

    "NEXT_PUBLIC_PRODUCT_LAUNCHED",

    "NEW_RELIC_ENABLED",
    "NEW_RELIC_LICENSE_KEY",
    "NEW_RELIC_APP_NAME",
    "NEW_RELIC_LOG_LEVEL",
    "LOG_LEVEL",
    "NEXT_RUNTIME",

    "STORAGE_PROVIDER",
    "GOOGLE_CLOUD_PROJECT_ID",
    "GOOGLE_CLOUD_CLIENT_EMAIL",
    "GOOGLE_CLOUD_PRIVATE_KEY",
    "GOOGLE_CLOUD_BUCKET_NAME",
    "GOOGLE_CLOUD_PROJECT",
    "GCS_BUCKET_NAME",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "S3_BUCKET_NAME",
    "LOCAL_STORAGE_PATH",
    "LOCAL_STORAGE_URL",

    "COMPANY_NAME",
    "ADMIN_EMAIL",
    "ADMIN_URL",

    "EMAIL_ENCRYPTION_KEY",
    "VERCEL_ENV"
  ],
  "globalDependencies": [],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "node_modules/.prisma/**"
      ]
    },
    "@buildbase/eslint-config#build": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": ["node_modules/.prisma/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "vitest.config.*"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "vitest.config.*"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "vitest.config.*"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "inputs": ["e2e/**", "playwright.config.*"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "vitest.config.*"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
