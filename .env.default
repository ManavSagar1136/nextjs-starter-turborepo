

# ============================================
# Environment Variables - Monorepo
# ============================================
# Copy this file to .env and fill in your values
# This file is shared across all apps in the monorepo

# Node Environment
NODE_ENV=development

# ============================================
# Database
# ============================================
DATABASE_URL=mongodb+srv://XXX:YYYY@AAAA.BBBB.mongodb.net/test-cm-template-nextjs?retryWrites=true&w=majority


# ============================================
# App URLs
# ============================================
NEXT_PUBLIC_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_USER_APP_URL=http://localhost:3101
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3102
NEXT_PUBLIC_DOCS_APP_URL=http://localhost:3103

# ============================================
# API Configuration
# ============================================
API_SECRET=your-secret-key-here-min-32-chars

## BuildBase app
## Client
NEXT_PUBLIC_SAAS_SERVER_URL=https://api.buildbase.app
NEXT_PUBLIC_SAAS_ORG_ID=XXXXXXX
NEXT_PUBLIC_SAAS_CLIENT_ID=YYYYY

## Server
SAAS_CLIENT_SECRET=XXXXXX

# JWT
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-chars-long

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_PRODUCT_LAUNCHED=false

# Logging & Monitoring
# ============================================
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# New Relic APM (optional)
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=


# ============================================
# Storage Provider
# ============================================
# Options: gcs | s3 | local
STORAGE_PROVIDER=local

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
# Uses standard Google Cloud environment variables
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Local Storage (when STORAGE_PROVIDER=local, for development)
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_URL=/uploads