# ============================================
# Environment Variables - Monorepo
# ============================================
# Copy this file to .env and fill in your values
# This file is shared across all apps in the monorepo

# Node Environment
NODE_ENV=development

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/cms_db?schema=public

# ============================================
# App URLs
# ============================================
PUBLIC_APP_URL=http://localhost:3100
USER_APP_URL=http://localhost:3101
ADMIN_APP_URL=http://localhost:3102
DOCS_APP_URL=http://localhost:3103

# ============================================
# API Configuration
# ============================================
API_URL=http://localhost:3100/api
API_SECRET=your-secret-key-here-min-32-chars

# ============================================
# Authentication (NextAuth.js)
# ============================================
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=your-nextauth-secret-here-min-32-chars

# ============================================
# Email/SMTP (Optional)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# ============================================
# Feature Flags
# ============================================
ENABLE_ANALYTICS=false
ENABLE_DEBUG=true

# ============================================
# Client-Side Variables (NEXT_PUBLIC_*)
# ============================================
# These are exposed to the browser
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3100/api
NEXT_PUBLIC_ENABLE_ANALYTICS=false
