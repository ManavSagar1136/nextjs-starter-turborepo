{
  "name": "nextjs-starter-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=40",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "check-types": "turbo run check-types",
    "type-check": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,css,json,yml,yaml}\"",
    "prepare": "husky install",
    "test": "turbo run test",
    "ralph": "./scripts/ralph/ralph.sh",
    "ralph:claude": "./scripts/ralph/ralph.sh --tool claude",
    "ralph:amp": "./scripts/ralph/ralph.sh --tool amp"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.4",
    "turbo": "^2.7.3"
  },
  "resolutions": {
    "jiti": "^2.6.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
