{
  "name": "nextjs-starter-turborepo",
  "private": true,
  "description": "Production-ready Turborepo monorepo for building multi-tenant SaaS apps with Next.js and BuildBase",
  "author": "buildbase <support@buildbase.app> (https://www.buildbase.app)",
  "license": "MIT",
  "homepage": "https://www.buildbase.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/buildbase-app/nextjs-starter-turborepo.git"
  },
  "bugs": {
    "url": "https://github.com/buildbase-app/nextjs-starter-turborepo/issues"
  },
  "scripts": {
    "build": "turbo run build --filter=!@buildbase/video",
    "dev": "turbo run dev --concurrency=40 --filter=!@buildbase/video",
    "lint": "turbo run lint --filter=!@buildbase/video",
    "lint:fix": "turbo run lint --fix --filter=!@buildbase/video",
    "check-types": "turbo run check-types --filter=!@buildbase/video",
    "type-check": "turbo run check-types --filter=!@buildbase/video",
    "typecheck": "turbo run check-types --filter=!@buildbase/video",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,css,json,yml,yaml}\"",
    "prepare": "husky install",
    "test": "turbo run test",
    "ralph": "./scripts/ralph/ralph.sh",
    "ralph:claude": "./scripts/ralph/ralph.sh --tool claude",
    "ralph:amp": "./scripts/ralph/ralph.sh --tool amp"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.4",
    "turbo": "^2.7.3"
  },
  "resolutions": {"fast-uri": "3.1.8", 
    "jiti": "^2.6.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
