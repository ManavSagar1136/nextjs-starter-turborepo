{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "check-types": "turbo run check-types",
    "type-check": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,css,json,yml,yaml}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "turbo": "^2.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
