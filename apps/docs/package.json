{
  "name": "docs",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3103 --turbopack",
    "dev:with-search": "next build && pagefind --site .next/server/app --output-path public/_pagefind && next dev --port 3103 --turbopack",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "check-types": "next typegen && tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.0.10",
    "nextra": "^4.0.0",
    "nextra-theme-docs": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "pagefind": "^1.1.0",
    "typescript": "5.9.2"
  }
}
