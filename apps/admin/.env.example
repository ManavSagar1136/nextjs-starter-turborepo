# ============================================
# Environment Variables - Monorepo
# ============================================
# Copy this file to .env and fill in your values
# This file is shared across all apps in the monorepo

# Node Environment
NODE_ENV=development

# ============================================
# Database
# ============================================
DATABASE_URL=mongodb+srv://user:password@localhost:5432/test-cm-template-nextjs?retryWrites=true&w=majority

# ============================================
# App URLs
# ============================================
NEXT_PUBLIC_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_USER_APP_URL=http://localhost:3101
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3102
NEXT_PUBLIC_DOCS_APP_URL=http://localhost:3103

# ============================================
# API Configuration
# ============================================
API_SECRET=your-secret-key-here-min-32-chars
NEXT_PUBLIC_API_SECRET=your-secret-key-here-min-32-chars

## BuildBase app
## Client
NEXT_PUBLIC_SAAS_SERVER_URL=https://api.buildbase.app
NEXT_PUBLIC_SAAS_ORG_ID=your-org-id-here
NEXT_PUBLIC_SAAS_CLIENT_ID=your-client-id-here

## Server
SAAS_CLIENT_SECRET=your-client-secret-here

# JWT
# Must be at least 32 characters. Generate with: openssl rand -hex 32
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-chars-long

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_PRODUCT_LAUNCHED=false