# Admin App Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Required Environment Variables
# ============================================

# Admin App URL (Client-side accessible)
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3102

# API Secret for client-side API calls
NEXT_PUBLIC_API_SECRET=your-api-secret-here

# SaaS SDK Configuration (Client-side accessible)
NEXT_PUBLIC_SAAS_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SAAS_ORG_ID=your-org-id-here
NEXT_PUBLIC_SAAS_CLIENT_ID=your-client-id-here

# SaaS SDK Server Secret (Server-side only)
SAAS_CLIENT_SECRET=your-saas-client-secret-here

# ============================================
# Server-side Environment Variables
# ============================================

# Database URL (Required for API routes that use database)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# API Secret (Server-side)
API_SECRET=your-server-api-secret-here

# JWT Secret for app authentication
APP_JWT_SECRET=your-jwt-secret-here

# ============================================
# Optional Environment Variables
# ============================================

# New Relic APM Configuration
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=admin-app
NEW_RELIC_LICENSE_KEY=

# Logging Configuration
LOG_LEVEL=info

# Cache Configuration (Redis/Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENABLE_CACHE_WARMING=false
CACHE_WARMING_INTERVAL=3600

# QStash Configuration (Upstash Message Queue)
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Cron Jobs (Vercel Cron)
CRON_SECRET=

# Storage Provider Configuration
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_URL=http://localhost:3102/storage

# Email Configuration
COMPANY_NAME=Your Company Name
ADMIN_EMAIL=admin@example.com
ADMIN_URL=http://localhost:3102
