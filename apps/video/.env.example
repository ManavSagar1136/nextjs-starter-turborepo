# ============================================
# apps/video — Environment Variables
# ============================================
# Copy to .env and fill in your values.
# ElevenLabs keys are used by @buildbase/voice for TTS voiceover generation.

# ------------------------------------------
# ElevenLabs (voiceover / TTS)
# ------------------------------------------
# Get your API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID from ElevenLabs voice library
# Default "Rachel" (US English, calm): 21m00Tcm4TlvDq8ikWAM
# Browse voices: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------
# Optional: Output path for generated audio
# ------------------------------------------
# Where generateVoiceover() saves .mp3 files.
# Defaults to ./public/audio/ if not set.
VOICEOVER_OUTPUT_DIR=./public/audio
