// Asset model - stores uploaded file metadata
model Asset {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  filename    String
  path        String // Storage path (e.g., "org123/abc123-image.png")
  url         String // Public URL (empty for private assets)
  size        Int // File size in bytes
  contentType String // MIME type
  bucket      String // Storage bucket name
  isPublic    Boolean @default(false)
  metadata    Json? // Arbitrary metadata (width, height, aspectRatio, etc.)

  // Organization/Workspace relationship
  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Uploader relationship
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Optional folder organization
  folderId String?      @db.ObjectId
  folder   AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Tags
  assetTags AssetTag[]

  // Blog post images
  blogPosts BlogPost[] @relation("BlogPostImage")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([path])
  @@index([contentType])
  @@index([workspaceId])
  @@index([userId])
  @@index([folderId])
  @@index([workspaceId, userId])
  @@index([workspaceId, folderId])
  @@map("assets")
}

// AssetFolder model - virtual folders for organizing assets
model AssetFolder {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  parentFolderId String? @db.ObjectId

  // Workspace relationship (null for admin-created folders)
  workspaceId String?    @db.ObjectId
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Creator relationship
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Self-referential for folder hierarchy
  parent   AssetFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children AssetFolder[] @relation("FolderHierarchy")

  // Assets in this folder
  assets Asset[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([parentFolderId])
  @@index([workspaceId, parentFolderId])
  @@map("asset_folders")
}

// AssetTag model - tags for categorizing assets
model AssetTag {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Asset relationship
  assetId String @db.ObjectId
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Tag relationship
  tagId String   @db.ObjectId
  tag   MediaTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())

  @@unique([assetId, tagId])
  @@index([assetId])
  @@index([tagId])
  @@map("asset_tags")
}

// MediaTag model - reusable tags
model MediaTag {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  slug  String
  color String?

  // Workspace relationship (null for admin-created tags)
  workspaceId String?    @db.ObjectId
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Creator relationship
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Asset tags using this tag
  assetTags AssetTag[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique slug per workspace (or null workspace for admin tags)
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("media_tags")
}
