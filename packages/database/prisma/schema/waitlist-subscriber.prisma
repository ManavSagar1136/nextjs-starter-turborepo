// Waitlist Subscriber model - stores waitlist signups
// Tracks position, invitation status, and conversion

enum WaitlistSubscriberStatus {
  PENDING    // Waiting in queue
  INVITED    // Invitation sent
  CONVERTED  // Signed up / converted
  EXPIRED    // Invitation expired
  UNSUBSCRIBED
}

model WaitlistSubscriber {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Identity
  email String @unique

  // Queue position (optional, for ordered waitlists)
  position Int?

  // Status
  status WaitlistSubscriberStatus @default(PENDING)

  // Source tracking
  source   String? // website, api, landing-page, referral
  sourceIp String?
  referrer String?

  // Referral tracking
  referredBy   String? // Email or ID of referrer
  referralCode String? @unique // This subscriber's referral code
  referralCount Int    @default(0) // Number of successful referrals

  // UTM tracking
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Timestamps
  subscribedAt   DateTime  @default(now())
  invitedAt      DateTime? // When invitation was sent
  convertedAt    DateTime? // When they signed up
  unsubscribedAt DateTime?

  // Invitation
  inviteToken   String?   @unique
  inviteExpires DateTime?

  // Multi-tenant
  workspaceId String?    @db.ObjectId
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  // Additional metadata (JSON)
  metadata Json?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([position])
  @@index([subscribedAt])
  @@index([workspaceId])
  @@index([referralCode])
  @@map("waitlist_subscribers")
}
