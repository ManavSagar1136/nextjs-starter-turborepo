// User model - stores user information from SDK authentication
model User {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  sdkUserId          String  @unique // User ID from Buildbase SDK
  email              String  @unique
  name               String?
  image              String?
  role               String? // e.g., "admin", "user"
  currentWorkspaceId String? @db.ObjectId // Current active workspace

  // Workspace relationships
  workspaces       WorkspaceMember[]
  currentWorkspace Workspace?        @relation("UserCurrentWorkspace", fields: [currentWorkspaceId], references: [id])

  // API keys created by this user
  apiKeysCreated ApiKey[] @relation("ApiKeyCreatedBy")

  // Email provider audit
  emailProvidersCreated EmailProvider[] @relation("EmailProviderCreatedBy")
  emailProvidersUpdated EmailProvider[] @relation("EmailProviderUpdatedBy")

  // Email template audit
  emailTemplatesCreated EmailTemplate[] @relation("EmailTemplateCreatedBy")
  emailTemplatesUpdated EmailTemplate[] @relation("EmailTemplateUpdatedBy")

  // Asset relationships
  assets       Asset[]
  assetFolders AssetFolder[]
  mediaTags    MediaTag[]

  // Blog post audit
  blogPostsCreated BlogPost[] @relation("BlogPostCreatedBy")
  blogPostsUpdated BlogPost[] @relation("BlogPostUpdatedBy")

  // Doc post audit
  docPostsUpdated DocPost[] @relation("DocPostUpdatedBy")

  // Changelog post audit
  changelogPostsCreated ChangelogPost[] @relation("ChangelogCreatedBy")
  changelogPostsUpdated ChangelogPost[] @relation("ChangelogUpdatedBy")

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Note: @unique on sdkUserId and email automatically creates indexes
  @@index([currentWorkspaceId])
  @@map("users")
}
