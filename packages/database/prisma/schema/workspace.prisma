// Workspace model - stores workspace information
model Workspace {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  sdkWorkspaceId String  @unique // Workspace ID from Buildbase SDK
  name           String
  image          String?
  slug           String? @unique
  description    String? // Workspace description
  isActive       Boolean @default(true) // Soft delete flag

  // Plan enforcement — synced from Buildbase SDK on subscription change
  // features: { [slug: string]: boolean }  e.g. { "api-access": true }
  // limits:   { [slug: string]: number | null }  null = unlimited
  features Json? // feature flags from subscription plan
  limits   Json? // hard caps from subscription plan

  // Workspace members
  members      WorkspaceMember[]
  currentUsers User[]            @relation("UserCurrentWorkspace") // Users with this as current workspace

  // API keys
  apiKeys ApiKey[]

  // Email providers
  emailProviders EmailProvider[]

  // Email templates
  emailTemplates EmailTemplate[]

  // Subscriber management
  newsletterSubscribers NewsletterSubscriber[]
  contactSubmissions    ContactSubmission[]

  // Asset relationships
  assets       Asset[]
  assetFolders AssetFolder[]
  mediaTags    MediaTag[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Note: @unique on sdkWorkspaceId and slug automatically creates indexes
  @@index([isActive])
  @@map("workspaces")
}
