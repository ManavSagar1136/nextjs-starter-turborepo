{
  "name": "@buildbase/magicui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@buildbase/ui": "*",
    "canvas-confetti": "^1.9.3",
    "cobe": "^0.6.3",
    "framer-motion": "^11.11.17",
    "react-tweet": "^3.2.1"
  },
  "devDependencies": {
    "@buildbase/eslint-config": "*",
    "@buildbase/tailwind-config": "*",
    "@buildbase/typescript-config": "*",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
