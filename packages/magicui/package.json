{
  "name": "@buildbase/magicui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./components/aurora-text": {
      "types": "./dist/components/aurora-text.d.ts",
      "default": "./dist/components/aurora-text.js"
    },
    "./components/avatar-circles": {
      "types": "./dist/components/avatar-circles.d.ts",
      "default": "./dist/components/avatar-circles.js"
    },
    "./components/number-ticker": {
      "types": "./dist/components/number-ticker.d.ts",
      "default": "./dist/components/number-ticker.js"
    },
    "./components/text-animate": {
      "types": "./dist/components/text-animate.d.ts",
      "default": "./dist/components/text-animate.js"
    },
    "./components/animated-gradient-text": {
      "types": "./dist/components/animated-gradient-text.d.ts",
      "default": "./dist/components/animated-gradient-text.js"
    },
    "./components/animated-subscribe-button": {
      "types": "./dist/components/animated-subscribe-button.d.ts",
      "default": "./dist/components/animated-subscribe-button.js"
    },
    "./components/hero-video-dialog": {
      "types": "./dist/components/hero-video-dialog.d.ts",
      "default": "./dist/components/hero-video-dialog.js"
    },
    "./components/sparkles-text": {
      "types": "./dist/components/sparkles-text.d.ts",
      "default": "./dist/components/sparkles-text.js"
    },
    "./components/rainbow-button": {
      "types": "./dist/components/rainbow-button.d.ts",
      "default": "./dist/components/rainbow-button.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@buildbase/ui": "*",
    "framer-motion": "^11.11.17"
  },
  "devDependencies": {
    "@buildbase/eslint-config": "*",
    "@buildbase/tailwind-config": "*",
    "@buildbase/typescript-config": "*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
