{
  "name": "@buildbase/components",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common/PageError": {
      "types": "./dist/common/PageError.d.ts",
      "default": "./dist/common/PageError.js"
    },
    "./common/custom-image": {
      "types": "./dist/common/custom-image.d.ts",
      "default": "./dist/common/custom-image.js"
    },
    "./common/header-card": {
      "types": "./dist/common/header-card.d.ts",
      "default": "./dist/common/header-card.js"
    },
    "./common/feature-line": {
      "types": "./dist/common/feature-line.d.ts",
      "default": "./dist/common/feature-line.js"
    },
    "./common/doc-headers": {
      "types": "./dist/common/doc-headers.d.ts",
      "default": "./dist/common/doc-headers.js"
    },
    "./common/hero-bg-wrapper": {
      "types": "./dist/common/hero-bg-wrapper.d.ts",
      "default": "./dist/common/hero-bg-wrapper.js"
    },
    "./common/SparklesSiteNameText": {
      "types": "./dist/common/SparklesSiteNameText.d.ts",
      "default": "./dist/common/SparklesSiteNameText.js"
    },
    "./common/sparkles-text": {
      "types": "./dist/common/sparkles-text.d.ts",
      "default": "./dist/common/sparkles-text.js"
    },
    "./common/NotLoggedIn": {
      "types": "./dist/common/NotLoggedIn.d.ts",
      "default": "./dist/common/NotLoggedIn.js"
    },
    "./common/AppIcon": {
      "types": "./dist/common/AppIcon.d.ts",
      "default": "./dist/common/AppIcon.js"
    },
    "./common/*": {
      "types": "./dist/common/*.d.ts",
      "default": "./dist/common/*.js"
    },
    "./components/*": "./dist/components/*.js",
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "default": "./dist/notifications/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@buildbase/ui": "*",
    "@buildbase/utils": "*",
    "aos": "^2.3.4",
    "framer-motion": "^11.11.17",
    "react-icons": "^5.0.0"
  },
  "devDependencies": {
    "@buildbase/eslint-config": "*",
    "@buildbase/tailwind-config": "*",
    "@buildbase/typescript-config": "*",
    "@types/aos": "^3.0.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
