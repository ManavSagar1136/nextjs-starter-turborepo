{
  "name": "@buildbase/components",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common/*": {
      "types": "./dist/common/*.d.ts",
      "default": "./dist/common/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "default": "./dist/notifications/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "default": "./dist/dashboard/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@buildbase/ui": "*",
    "@buildbase/utils": "*",
    "@buildbase/helpers": "*",
    "@buildbase/dialog-manager": "*",
    "aos": "^2.3.4",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.469.0",
    "react-email-editor": "^1.7.11",
    "react-hook-form": "^7.54.0",
    "react-icons": "^5.0.0"
  },
  "devDependencies": {
    "@buildbase/eslint-config": "*",
    "@buildbase/tailwind-config": "*",
    "@buildbase/typescript-config": "*",
    "@types/aos": "^3.0.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
