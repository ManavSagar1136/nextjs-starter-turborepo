{
  "name": "@buildbase/components",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common/*": {
      "types": "./dist/common/*.d.ts",
      "default": "./dist/common/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "default": "./dist/notifications/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "default": "./dist/dashboard/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./media-library": {
      "types": "./dist/media-library/index.d.ts",
      "default": "./dist/media-library/index.js"
    },
    "./markdown-editor": {
      "types": "./dist/markdown-editor/index.d.ts",
      "default": "./dist/markdown-editor/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "next": "^15",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@buildbase/dialog-manager": "*",
    "@buildbase/helpers": "*",
    "@buildbase/ui": "*",
    "@buildbase/utils": "*",
    "@mdxeditor/editor": "^3.52.3",
    "aos": "^2.3.4",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.469.0",
    "react-email-editor": "^1.7.11",
    "react-hook-form": "^7.54.0",
    "react-icons": "^5.0.0",
    "react-virtualized-auto-sizer": "^1.0.25",
    "react-window": "^1.8.11"
  },
  "devDependencies": {
    "@buildbase/eslint-config": "*",
    "@buildbase/tailwind-config": "*",
    "@buildbase/testing": "*",
    "@buildbase/typescript-config": "*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/aos": "^3.0.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.3"
  }
}
