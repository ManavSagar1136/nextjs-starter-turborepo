{
  "slug": "contact-confirmation",
  "name": "Contact Form Confirmation",
  "description": "Sent to the user after they submit a contact form",
  "subject": "Thanks for contacting {{companyName}}!",
  "category": "TRANSACTIONAL",
  "variables": [
    { "name": "firstName", "type": "string", "required": false, "default": "", "description": "User's first name" },
    { "name": "lastName", "type": "string", "required": false, "default": "", "description": "User's last name" },
    { "name": "email", "type": "string", "required": true, "description": "User's email" },
    { "name": "companyName", "type": "string", "required": false, "default": "Our Company", "description": "Company name" },
    { "name": "siteUrl", "type": "string", "required": false, "default": "#", "description": "Website URL" }
  ],
  "html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"><title>Thanks for Contacting Us</title></head><body style=\"margin:0;padding:0;font-family:Arial,sans-serif;background-color:#f4f4f4\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;margin:0 auto;background-color:#ffffff\"><tr><td style=\"padding:40px 30px;text-align:center;background-color:#0e7dc2\"><h1 style=\"color:#ffffff;margin:0;font-size:28px\">Thanks for reaching out!</h1></td></tr><tr><td style=\"padding:40px 30px\"><p style=\"font-size:16px;line-height:1.6;color:#333333;margin:0 0 20px\">Hi {{firstName}} {{lastName}},</p><p style=\"font-size:16px;line-height:1.6;color:#333333;margin:0 0 20px\">Thank you for contacting <strong>{{companyName}}</strong>. We have received your message and our team will get back to you shortly.</p><p style=\"font-size:16px;line-height:1.6;color:#333333;margin:0 0 20px\">If you have any urgent queries, feel free to contact us directly.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:0 auto\"><tr><td style=\"background-color:#0e7dc2;border-radius:5px\"><a href=\"{{siteUrl}}\" style=\"display:inline-block;padding:15px 30px;color:#ffffff;text-decoration:none;font-weight:bold\">Visit Our Website</a></td></tr></table></td></tr><tr><td style=\"padding:30px;background-color:#f8f8f8;text-align:center\"><p style=\"font-size:14px;color:#666666;margin:0\">Thanks,<br>The {{companyName}} Team</p></td></tr></table></body></html>",
  "text": "Thanks for reaching out!\n\nHi {{firstName}} {{lastName}},\n\nThank you for contacting {{companyName}}. We have received your message and our team will get back to you shortly.\n\nIf you have any urgent queries, feel free to contact us directly.\n\nVisit our website: {{siteUrl}}\n\nThanks,\nThe {{companyName}} Team"
}
