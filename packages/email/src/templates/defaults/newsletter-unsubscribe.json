{
  "slug": "newsletter-unsubscribe",
  "name": "Newsletter Unsubscribe Confirmation",
  "description": "Sent when a user unsubscribes from the newsletter",
  "subject": "You've been unsubscribed from {{companyName}}",
  "category": "TRANSACTIONAL",
  "variables": [
    {
      "name": "email",
      "type": "string",
      "required": true,
      "description": "Subscriber email"
    },
    {
      "name": "companyName",
      "type": "string",
      "required": false,
      "default": "Our Company",
      "description": "Company name"
    },
    {
      "name": "resubscribeUrl",
      "type": "string",
      "required": false,
      "default": "#",
      "description": "URL to resubscribe"
    }
  ],
  "html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"><title>Unsubscribed</title></head><body style=\"margin:0;padding:0;font-family:Arial,sans-serif;background-color:#f4f4f4\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;margin:0 auto;background-color:#ffffff\"><tr><td style=\"padding:40px 30px;text-align:center;background-color:#6c757d\"><h1 style=\"color:#ffffff;margin:0;font-size:28px\">Unsubscribed</h1></td></tr><tr><td style=\"padding:40px 30px\"><p style=\"font-size:16px;line-height:1.6;color:#333333;margin:0 0 20px\">Hi,</p><p style=\"font-size:16px;line-height:1.6;color:#333333;margin:0 0 20px\">You have been successfully unsubscribed from the <strong>{{companyName}}</strong> newsletter.</p><p style=\"font-size:16px;line-height:1.6;color:#333333;margin:0 0 20px\">We're sorry to see you go! If this was a mistake or you change your mind, you can always resubscribe.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:0 auto\"><tr><td style=\"background-color:#0e7dc2;border-radius:5px\"><a href=\"{{resubscribeUrl}}\" style=\"display:inline-block;padding:15px 30px;color:#ffffff;text-decoration:none;font-weight:bold\">Resubscribe</a></td></tr></table></td></tr><tr><td style=\"padding:30px;background-color:#f8f8f8;text-align:center\"><p style=\"font-size:14px;color:#666666;margin:0\">Thanks,<br>The {{companyName}} Team</p></td></tr></table></body></html>",
  "text": "Unsubscribed\n\nHi,\n\nYou have been successfully unsubscribed from the {{companyName}} newsletter.\n\nWe're sorry to see you go! If this was a mistake or you change your mind, you can always resubscribe:\n{{resubscribeUrl}}\n\nThanks,\nThe {{companyName}} Team"
}
