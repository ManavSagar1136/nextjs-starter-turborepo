{
  "name": "@buildbase/email",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Enterprise email package with multi-provider support, templates, and queue",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "default": "./dist/core/types.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "default": "./dist/service/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    }
  },
  "dependencies": {
    "@buildbase/database": "*",
    "@buildbase/env": "*",
    "@buildbase/qstash": "*",
    "nodemailer": "^6.9.0",
    "resend": "^4.0.0",
    "mailgun.js": "^10.0.0",
    "@sendgrid/mail": "^8.0.0",
    "@aws-sdk/client-ses": "^3.0.0",
    "form-data": "^4.0.0",
    "handlebars": "^4.7.0",
    "html-to-text": "^9.0.0"
  },
  "devDependencies": {
    "@buildbase/eslint-config": "*",
    "@buildbase/typescript-config": "*",
    "@buildbase/testing": "*",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.0",
    "@types/html-to-text": "^9.0.0",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  }
}
