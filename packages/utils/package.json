{
  "name": "@buildbase/utils",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./format": "./dist/format.js",
    "./validation": "./dist/validation.js",
    "./path-utils": {
      "types": "./dist/path-utils.d.ts",
      "default": "./dist/path-utils.js"
    },
    "./config": {
      "types": "./dist/config/site-config.d.ts",
      "default": "./dist/config/site-config.js"
    },
    "./config/types": {
      "types": "./dist/config/types.d.ts",
      "default": "./dist/config/types.js"
    }
  },
  "dependencies": {
    "@buildbase/env": "*"
  },
  "devDependencies": {
    "@buildbase/eslint-config": "*",
    "@buildbase/typescript-config": "*",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
