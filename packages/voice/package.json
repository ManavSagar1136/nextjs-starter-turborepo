{
  "name": "@buildbase/voice",
  "version": "0.0.1",
  "description": "ElevenLabs TTS voiceover utility for use with Remotion <Audio> compositions",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@buildbase/eslint-config": "*",
    "@buildbase/typescript-config": "*",
    "@types/node": "^22.15.30",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
